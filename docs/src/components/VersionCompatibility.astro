---
interface Props {
	version: string;
	kind?: 'changed' | 'new';
}

const { version, kind = 'new' } = Astro.props;
const label = kind === 'changed' ? `Changed in v${version}` : `Available since v${version}`;
---

{
	kind === 'changed' ? (
		<aside class="version-compat">
			<p>
				<strong>{label}.</strong> <slot />
			</p>
		</aside>
	) : (
		<span class="version-badge">{label}</span>
	)
}

<style>
	.version-badge {
		display: inline-block;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 999px;
		font-size: var(--sl-text-xs);
		padding: 0.1rem 0.6rem;
		white-space: nowrap;
	}

	.version-compat {
		border: 1px solid var(--sl-color-gray-5);
		border-left: 3px solid var(--sl-color-accent);
		border-radius: 0.5rem;
		padding: 0.75rem 1rem;
	}
</style>
